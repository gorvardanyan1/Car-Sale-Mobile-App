# Laravel API base URL (no trailing slash) — must end with /api/v1
# Example: http://autohayq/api/v1
# AI support uses /api/ai-support (apiRootUrl strips the trailing /v1 automatically).
EXPO_PUBLIC_API_URL=http://autohayq/api/v1

# Socket.io / chat REST server (car-shop-chat-app), e.g. http://192.168.0.109:3000
# Required — on a physical device "localhost" resolves to the device itself, not
# your dev machine, so this cannot default to the same host as EXPO_PUBLIC_API_URL.
# Must be reachable from the device and match the chat server's PORT.
EXPO_PUBLIC_CHAT_URL=

# Must match MOBILE_APP_SECRET in the car_sale backend's .env — every /api/v1
# request is HMAC-signed with this value (see src/lib/api/signRequest.ts).
EXPO_PUBLIC_MOBILE_APP_SECRET=

# Sign in with Google — native OAuth client IDs from the Google Cloud console.
# Create one client per platform (Android needs package name + SHA-1; iOS needs
# only the bundle id). These are PUBLIC identifiers: a native OAuth client has no
# secret, and anything EXPO_PUBLIC_* ships inside the app bundle. Never put a
# client *secret* here. Every ID used must also be listed in the server's
# GOOGLE_MOBILE_CLIENT_IDS, which is the `aud` allowlist the API verifies against.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
